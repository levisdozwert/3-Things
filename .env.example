# Optional. When set, recordings are turned into three things by Claude
# (see server/distill.ts). Without it, the app runs in preview mode and uses
# sample conversations so the full flow can still be explored.
ANTHROPIC_API_KEY=

# Optional override for how hard the editor thinks before answering.
# low | medium | high  (default: medium, keeps the wait to a few seconds)
DISTILL_EFFORT=medium
